<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bootlabs</groupId>
    <artifactId>keycloak-custom-theme-v3</artifactId>
    <version>1.0.0</version>

    <name>Keycloak Custom Theme</name>
    <description>Custom Keycloak theme for login/account/email</description>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources/theme</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>

            <!-- Run script to update footer -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>update-footer</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>scripts/update-footer.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>deploy-theme</id>
                        <phase>install</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    THEME_DIR=$(find src/main/resources/theme -maxdepth 1 -type d -name "keycloak-custom-theme*") &amp;&amp; docker cp ${THEME_DIR} keycloak:/opt/keycloak/themes/ &amp;&amp; docker restart keycloak
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- Copy theme to target -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-theme-to-target</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/theme</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/theme</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>